---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getCases } from '@/lib/data';
const cases = getCases();
const ranked = cases.map(c=>{const pr=(c.dropRates.find(d=>d.rarity==='Epic')?.chance??0)+(c.dropRates.find(d=>d.rarity==='Legendary')?.chance??0);return {...c,pr,ppb:pr/c.price};}).sort((a,b)=>b.ppb-a.ppb);
const RC: Record<string,string> = {Common:'bg-gray-400',Uncommon:'bg-green-500',Rare:'bg-blue-500',Epic:'bg-purple-500',Legendary:'bg-amber-500'};
---
<BaseLayout title="Monkey Bomb Tag Best Cases — Ranked by Value" description="Which Monkey Bomb Tag case gives the best value? ROI analysis with drop rates for Void Crate, Tails Case and more." path="/best-cases/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Best Cases',item:'https://monkey-bomb-tag.pages.dev/best-cases/'}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">📦 Best Cases — ROI Guide</h1>
  <p class="text-gray-500 text-sm mb-6">Every case ranked by value.</p>
  <div class="mb-6 p-4 rounded-xl bg-green-50 dark:bg-green-950/30 border border-green-200 text-sm"><strong>🥇 Void Crate</strong> (500🍌) best rates · <strong>🥈 Tails Case</strong> (250🍌) best budget</div>
  <section class="mb-8"><table class="w-full text-sm"><thead><tr class="border-b border-gray-200 dark:border-gray-800"><th class="text-left py-2 px-1">#</th><th class="text-left py-2">Case</th><th class="text-right py-2">Price</th><th class="text-right py-2">Epic</th><th class="text-right py-2">Leg.</th></tr></thead><tbody>{ranked.map((c,i)=>(<tr class={'border-b border-gray-100 dark:border-gray-900'+(i===0?' bg-green-50 dark:bg-green-950/20':'')}><td class="py-2 px-1">{i===0?'🥇':i===1?'🥈':'#'+(i+1)}</td><td class="py-2 font-bold">{c.name}</td><td class="py-2 text-right font-mono text-amber-500">🍌{c.price}</td><td class="py-2 text-right font-mono">{(c.dropRates.find(d=>d.rarity==='Epic')?.chance??0)*100}%</td><td class="py-2 text-right font-mono">{(c.dropRates.find(d=>d.rarity==='Legendary')?.chance??0)*100}%</td></tr>))}</tbody></table></section>
  <section class="space-y-4">{ranked.map((c,i)=>(<div class={'p-4 rounded-xl border '+(i===0?'border-green-300':'border-gray-200 dark:border-gray-800')}><div class="flex justify-between mb-2"><h3 class="font-bold">{i===0&&'🥇 '}{c.name}</h3><span class="font-mono font-bold text-amber-500">🍌{c.price}</span></div><p class="text-xs text-gray-600 dark:text-gray-400 mb-2">{c.description.slice(0,100)}</p><div class="space-y-1">{c.dropRates.map(dr=>(<div class="flex items-center gap-2"><span class="w-16 text-xs">{dr.rarity}</span><div class="flex-1 h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden"><div class={'h-full rounded-full '+(RC[dr.rarity]||'bg-gray-400')} style={'width:'+Math.min(dr.chance*100,100)+'%'}></div></div><span class="w-10 text-right text-xs font-mono">{(dr.chance*100).toFixed(0)}%</span></div>))}</div></div>))}</section>
  <div class="mt-6 flex flex-wrap gap-2"><a href="/case-calculator/" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🧮 Case Calculator</a><a href="/best-tails/" class="px-4 py-2 bg-purple-600 text-white rounded-lg text-sm font-semibold">🐒 Best Tails</a></div>
</div>
</BaseLayout>
