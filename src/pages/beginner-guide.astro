---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
---
<BaseLayout title="Beginner Guide — How to Win" description="Complete guide: controls, movement techniques, beginner tips, advanced strategies and map advice." path="/beginner-guide/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Guide',item:'https://monkey-bomb-tag.pages.dev/beginner-guide/'}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">📖 Beginner Guide</h1>
  <p class="text-gray-500 text-sm mb-8">From basics to advanced.</p>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🎮 Basics</h2><p class="text-sm text-gray-600">Up to 16 players. One gets a bomb. Tag to pass. Holder when timer hits zero = eliminated. Last standing wins Bananas.</p></section>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🎯 Controls</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800"><h3 class="font-bold text-sm mb-1">🖱️ PC</h3><ul class="text-xs text-gray-600 space-y-0.5"><li>WASD — Move</li><li>Space — Jump / Wall Jump</li><li>Shift — Sprint</li></ul></div><div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800"><h3 class="font-bold text-sm mb-1">🎮 Controller</h3><ul class="text-xs text-gray-600 space-y-0.5"><li>Left Stick — Move</li><li>A — Jump</li><li>B — Sprint</li></ul></div></div></section>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🌱 Tips</h2><div class="space-y-2">{[{t:'Keep Moving',d:'Never stand still.'},{t:'Watch the Timer',d:'Under 5s, holder gets desperate.'},{t:'Use Codes',d:'Free Bananas from Codes page.'},{t:'Wall Jump',d:'Essential for vertical maps.'},{t:'Stay in Pack',d:'Don\'t be the closest target.'}].map((tip,i)=>(<div class="p-3 rounded-lg border border-gray-200 dark:border-gray-800"><h3 class="font-bold text-green-700 dark:text-green-400 text-sm">{i+1}. {tip.t}</h3><p class="text-xs text-gray-600">{tip.d}</p></div>))}</div></section>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🏅 Advanced</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800"><h3 class="font-bold text-sm mb-1">🎯 Tagging</h3><ul class="text-xs text-gray-600 space-y-0.5"><li>Intercept — cut off, don't chase</li><li>Corner trap</li><li>Group targeting</li></ul></div><div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800"><h3 class="font-bold text-sm mb-1">🛡️ Surviving</h3><ul class="text-xs text-gray-600 space-y-0.5"><li>Circle strafe</li><li>Use high ground</li><li>Timed last-second jumps</li></ul></div></div></section>
  <div class="flex flex-wrap gap-2"><a href="/codes" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">🎫 Codes</a><a href="/banana-farm-guide" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🍌 Farm Guide</a><a href="/wiki" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold">📚 Wiki</a></div>
</div>
</BaseLayout>
