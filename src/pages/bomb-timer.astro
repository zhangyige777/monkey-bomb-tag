---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
const title = 'Bomb Timer Simulator';
const desc = 'Practice the Monkey Bomb Tag bomb timer countdown. Free online tool to improve your reaction time.';
---
<BaseLayout title={title} description={desc} path="/bomb-timer/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Bomb Timer',item:'https://monkey-bomb-tag.pages.dev/bomb-timer/'}]}]} />
<div class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">💣 Bomb Timer Simulator</h1>
  <p class="text-gray-500 text-sm mb-8">Practice your timing. Hit PASS before it explodes!</p>
  <div class="text-center mb-8">
    <div id="timer-display" class="text-7xl font-black text-gray-300 dark:text-gray-700 mb-4">30</div>
    <div id="timer-status" class="text-sm text-gray-400 mb-6">Pick a duration and hit Start</div>
    <div class="flex justify-center gap-3 mb-4">
      <button onclick="startTimer(15)" class="px-5 py-2 bg-green-500 text-white rounded-lg font-bold hover:bg-green-600">15s</button>
      <button onclick="startTimer(20)" class="px-5 py-2 bg-amber-500 text-white rounded-lg font-bold hover:bg-amber-600">20s</button>
      <button onclick="startTimer(30)" class="px-5 py-2 bg-red-500 text-white rounded-lg font-bold hover:bg-red-600">30s</button>
    </div>
    <button id="pass-btn" onclick="passBomb()" class="px-8 py-4 bg-green-600 text-white rounded-xl font-black text-lg hover:bg-green-700 transition-colors disabled:opacity-30" disabled>👋 PASS!</button>
  </div>
  <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
    <h2 class="font-bold mb-2 text-sm">💡 Tips</h2>
    <ul class="text-xs text-gray-600 dark:text-gray-400 space-y-0.5">
      <li>• Real game timers vary — shorter in multi-bomb rounds</li>
      <li>• Practice reacting in the last 5 seconds</li>
      <li>• The bomb flashes faster near explosion</li>
    </ul>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href="/survival-calculator" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold">📊 Survival Odds</a>
    <a href="/codes" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">🎫 Codes</a>
  </div>
</div>
<script is:inline>
let interval,seconds;
function startTimer(s){clearInterval(interval);seconds=s;document.getElementById('pass-btn').disabled=false;const d=document.getElementById('timer-display'),st=document.getElementById('timer-status');st.textContent='💣 Tick tick tick...';d.className='text-7xl font-black text-green-500 mb-4';interval=setInterval(()=>{seconds--;d.textContent=seconds;if(seconds<=5)d.className='text-7xl font-black text-red-500 mb-4';else if(seconds<=10)d.className='text-7xl font-black text-amber-500 mb-4';if(seconds<=0){clearInterval(interval);d.textContent='💥';st.textContent='BOOM! Too slow!';document.getElementById('pass-btn').disabled=true;}},1000);}
function passBomb(){clearInterval(interval);document.getElementById('timer-display').textContent='✅';document.getElementById('timer-display').className='text-7xl font-black text-green-500 mb-4';document.getElementById('timer-status').textContent='Passed with '+seconds+'s to spare!';document.getElementById('pass-btn').disabled=true;}
</script>
</BaseLayout>
