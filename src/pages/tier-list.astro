---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getTails, getCases, getCosmeticsByType } from '@/lib/data';
const tails = getTails(); const cases = getCases(); const bombs = getCosmeticsByType('bomb'); const effects = getCosmeticsByType('effect');
const tiers = ['S','A','B','C','D'];
const TC: Record<string,{c:string,b:string,l:string}> = {S:{c:'text-red-400',b:'bg-red-500/10 border-red-500/30',l:'S Tier'},A:{c:'text-orange-400',b:'bg-orange-500/10 border-orange-500/30',l:'A Tier'},B:{c:'text-yellow-400',b:'bg-yellow-500/10 border-yellow-500/30',l:'B Tier'},C:{c:'text-blue-400',b:'bg-blue-500/10 border-blue-500/30',l:'C Tier'},D:{c:'text-gray-400',b:'bg-gray-500/10 border-gray-500/30',l:'D Tier'}};
const RC: Record<string,string> = {Common:'bg-gray-200 dark:bg-gray-700 text-gray-600',Uncommon:'bg-green-200 dark:bg-green-900 text-green-700',Rare:'bg-blue-200 dark:bg-blue-900 text-blue-700',Epic:'bg-purple-200 dark:bg-purple-900 text-purple-700',Legendary:'bg-amber-200 dark:bg-amber-900 text-amber-700'};
---
<BaseLayout title="Tier List — Tails, Cases & Items" description="All Monkey Bomb Tag items ranked S to D tier with drop rates." path="/tier-list/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Tier List',item:'https://monkey-bomb-tag.pages.dev/tier-list/'}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-6">🏆 Tier List</h1>
  <section class="mb-8"><h2 class="text-lg font-bold mb-3">🐒 Tails</h2>{tiers.map(tier=>{const tt=tails.filter(t=>t.tier===tier);if(!tt.length)return null;const cfg=TC[tier];return (<div class={'mb-3 p-3 rounded-xl border '+cfg.b}><h3 class={'text-sm font-bold mb-2 '+cfg.c}>{cfg.l}</h3><div class="grid grid-cols-2 lg:grid-cols-3 gap-2">{tt.map(t=>(<div class="p-2 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700"><div class="flex justify-between text-sm"><span class="font-bold">{t.name}</span><span class={'px-1.5 py-0.5 rounded text-xs font-bold '+(RC[t.rarity]||'')}>{t.rarity}</span></div><div class="text-xs text-gray-500 flex justify-between mt-1"><span>{t.source}</span><span class="text-amber-500 font-mono">{(t.dropRate*100).toFixed(1)}%</span></div></div>))}</div></div>);})}</section>
  <section class="mb-8"><h2 class="text-lg font-bold mb-3">📦 Cases</h2>{tiers.map(tier=>{const cc=cases.filter(c=>c.tier===tier);if(!cc.length)return null;const cfg=TC[tier];return (<div class={'mb-3 p-3 rounded-xl border '+cfg.b}><h3 class={'text-sm font-bold mb-2 '+cfg.c}>{cfg.l}</h3><div class="grid grid-cols-2 lg:grid-cols-3 gap-2">{cc.map(c=>(<div class="p-2 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700"><div class="flex justify-between text-sm"><span class="font-bold">{c.name}</span><span class="text-amber-500 font-mono">🍌{c.price}</span></div><p class="text-xs text-gray-500 mt-1">{c.description.slice(0,60)}...</p></div>))}</div></div>);})}</section>
  <section class="mb-8"><h2 class="text-lg font-bold mb-3">💣 Bombs & ✨ Effects</h2><div class="grid grid-cols-2 sm:grid-cols-4 gap-2">{[...bombs,...effects].map(i=>(<div class="p-2 rounded-lg border border-gray-200 dark:border-gray-700"><div class="flex justify-between text-xs"><span class="font-bold">{i.name}</span><span class={'px-1 py-0.5 rounded text-xs font-bold '+(RC[i.rarity]||'')}>{i.rarity}</span></div></div>))}</div></section>
  <div class="flex flex-wrap gap-2"><a href="/codes" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">🎫 Codes</a><a href="/case-calculator" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🧮 Calculator</a></div>
</div>
</BaseLayout>
