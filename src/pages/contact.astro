---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
---
<BaseLayout title="Contact Us — Monkey Bomb Tag Guide" description="Contact the Monkey Bomb Tag Guide team for questions, corrections, or business inquiries." path="/contact/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Contact',item:'https://monkey-bomb-tag.pages.dev/contact/'}]}]} />
<div class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">Contact Us</h1>
  <p class="text-gray-500 text-sm mb-8">Questions, corrections, or business inquiries? Reach out below.</p>
  <div class="space-y-6">
    <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
      <h2 class="font-bold mb-2">General Questions</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400">For questions about Monkey Bomb Tag game content, codes, or guides on our site, feel free to reach out.</p>
    </div>
    <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
      <h2 class="font-bold mb-2">Corrections &amp; Updates</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400">Found outdated codes, incorrect drop rates, or wrong information? Let us know so we can fix it quickly.</p>
    </div>
    <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
      <h2 class="font-bold mb-2">Business &amp; Partnerships</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400">For advertising, sponsorships, or partnership inquiries, please contact us via email.</p>
    </div>
    <div class="p-6 rounded-xl bg-green-50 dark:bg-green-950/20 border border-green-200 text-center">
      <p class="font-bold text-green-700 dark:text-green-400 mb-1">Email</p>
      <p class="text-sm">contact@monkey-bomb-tag.pages.dev</p>
    </div>
  </div>
  <div class="mt-8 text-center text-xs text-gray-400">
    <p>This is a fan-made site and is not affiliated with Roblox Corporation or Crazay Games.</p>
  </div>
</div>
</BaseLayout>
