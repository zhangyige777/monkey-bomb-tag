---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getCases } from '@/lib/data';
const cases = getCases();
---
<BaseLayout title="Monkey Bomb Tag Case Drop Rate Calculator" description="Calculate your odds of getting rare items from Monkey Bomb Tag cases. See exact drop rates and costs." path="/case-calculator/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Case Calculator',item:'https://monkey-bomb-tag.pages.dev/case-calculator/'}]},{'@context':'https://schema.org','@type':'SoftwareApplication','name':'Monkey Bomb Tag Case Calculator','applicationCategory':'GameApplication','operatingSystem':'Web','offers':{'@type':'Offer','price':'0','priceCurrency':'USD'}}]} />
<div class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">🧮 Case Drop Calculator</h1>
  <p class="text-gray-500 text-sm mb-8">Your odds and how many openings you need.</p>
  <div class="space-y-4 mb-8">
    <div><label class="block text-sm font-bold mb-1">Select Case</label><select id="cs" class="w-full p-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900" onchange="calc()">{cases.map(c=><option value={c.id}>{c.name} (🍌{c.price})</option>)}</select></div>
    <div><label class="block text-sm font-bold mb-1">Target Rarity</label><select id="rar" class="w-full p-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900" onchange="calc()"><option value="Rare">Rare</option><option value="Epic">Epic</option><option value="Legendary" selected>Legendary</option></select></div>
    <div><label class="block text-sm font-bold mb-1">Openings</label><input id="n" type="number" min="1" max="1000" value="10" class="w-full p-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900" oninput="calc()"></div>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div class="p-4 rounded-xl bg-purple-50 dark:bg-purple-950/20 border border-purple-200 text-center"><div class="text-xs text-gray-500">Chance ≥1 Drop</div><div id="chance" class="text-2xl font-black text-purple-500">40%</div></div>
    <div class="p-4 rounded-xl bg-amber-50 dark:bg-amber-950/20 border border-amber-200 text-center"><div class="text-xs text-gray-500">Avg Needed</div><div id="avg" class="text-2xl font-black text-amber-500">20</div></div>
    <div class="p-4 rounded-xl bg-green-50 dark:bg-green-950/20 border border-green-200 text-center"><div class="text-xs text-gray-500">Total Cost</div><div id="cost" class="text-2xl font-black text-green-500">10K🍌</div></div>
    <div class="p-4 rounded-xl bg-blue-50 dark:bg-blue-950/20 border border-blue-200 text-center"><div class="text-xs text-gray-500">Cost for 50%</div><div id="c50" class="text-2xl font-black text-blue-500">7K🍌</div></div>
  </div>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href="/best-cases/" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-semibold">📦 Best Cases</a>
    <a href="/banana-calculator/" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🍌 Banana Calc</a>
  </div>
</div>
<div id="case-data" data-cases={JSON.stringify(cases.map(c=>({id:c.id,price:c.price,dr:c.dropRates})))} style="display:none"></div>
<script is:inline>
const D=JSON.parse(document.getElementById('case-data').dataset.cases);
function calc(){const c=D.find(x=>x.id===document.getElementById('cs').value);const r=document.getElementById('rar').value;const n=parseInt(document.getElementById('n').value)||1;const p=(c.dr.find(d=>d.rarity===r)||{chance:0}).chance;const ch=(1-Math.pow(1-p,n))*100;document.getElementById('chance').textContent=Math.min(ch,99.9).toFixed(1)+'%';document.getElementById('avg').textContent=Math.round(1/p);document.getElementById('cost').textContent=(n*c.price).toLocaleString()+'🍌';document.getElementById('c50').textContent=Math.round(Math.log(0.5)/Math.log(1-p)*c.price).toLocaleString()+'🍌';if(typeof trackEvent==='function')trackEvent('calculator_submit',{tool:'case',case_id:document.getElementById('cs').value,rarity:r,openings:n});}
calc();
</script>
</BaseLayout>
