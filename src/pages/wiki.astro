---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getMaps, getCosmeticsByType, getGameConfig } from '@/lib/data';
const config = getGameConfig(); const maps = getMaps(); const bombs = getCosmeticsByType('bomb'); const effects = getCosmeticsByType('effect'); const emotes = getCosmeticsByType('emote');
const RC: Record<string,string> = {Common:'bg-gray-200 dark:bg-gray-700 text-gray-600',Uncommon:'bg-green-200 dark:bg-green-900 text-green-700',Rare:'bg-blue-200 dark:bg-blue-900 text-blue-700',Epic:'bg-purple-200 dark:bg-purple-900 text-purple-700',Legendary:'bg-amber-200 dark:bg-amber-900 text-amber-700'};
const DC: Record<string,string> = {Easy:'bg-green-100 dark:bg-green-900 text-green-700',Medium:'bg-yellow-100 dark:bg-yellow-900 text-yellow-700',Hard:'bg-red-100 dark:bg-red-900 text-red-700'};
---
<BaseLayout title="Monkey Bomb Tag Wiki — Complete Game Guide" description="Complete Monkey Bomb Tag wiki covering maps, game modes, cosmetics, controls and all game mechanics." path="/wiki/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Wiki',item:'https://monkey-bomb-tag.pages.dev/wiki/'}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-6">📚 Wiki</h1>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🎮 Overview</h2><div class="grid grid-cols-2 sm:grid-cols-3 gap-2">{[{l:'Developer',v:config.game.developer},{l:'Platform',v:'Roblox'},{l:'Visits',v:config.stats.visits},{l:'Server',v:config.stats.serverSize+'p'},{l:'Favorites',v:config.stats.favorites},{l:'Released',v:'Jan 2026'}].map(s=>(<div class="p-2 rounded-lg border border-gray-200 dark:border-gray-800"><div class="text-xs text-gray-400">{s.l}</div><div class="font-bold text-sm">{s.v}</div></div>))}</div><p class="text-xs text-gray-400 mt-2">Last checked: {config.stats.lastChecked}</p></section>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🎲 Game Modes</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-3">{[{n:'Classic',e:'🎯',d:'Free-for-all, 2-16 players'},{n:'Ranked',e:'📈',d:'Competitive with ELO'},{n:'Duels',e:'⚔️',d:'1v1 battles'},{n:'Lava',e:'🌋',d:'Environmental hazards'}].map(m=>(<div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800 flex items-start gap-2"><span class="text-xl">{m.e}</span><div><h3 class="font-bold text-sm">{m.n}</h3><p class="text-xs text-gray-600">{m.d}</p></div></div>))}</div></section>
  <section class="mb-8"><h2 class="text-xl font-bold mb-3">🗺️ Maps ({maps.length})</h2><div class="space-y-2">{maps.map(m=>(<div class="p-3 rounded-lg border border-gray-200 dark:border-gray-800"><div class="flex justify-between mb-1"><h3 class="font-bold text-sm">{m.name}</h3><span class={'px-2 py-0.5 rounded text-xs font-bold '+(DC[m.difficulty]||'')}>{m.difficulty}</span></div><p class="text-xs text-gray-600">{m.description.slice(0,80)}...</p></div>))}</div></section>
  <section class="mb-8"><h2 class="text-lg font-bold mb-2">💰 Cases</h2><div class="grid grid-cols-5 gap-2 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/20 border border-amber-200">{[{n:'Bomb',p:200},{n:'Emote',p:200},{n:'Tails',p:250},{n:'Effects',p:300},{n:'Void',p:500}].map(c=>(<div class="text-center"><div class="font-bold text-amber-600 text-sm">🍌{c.p}</div><div class="text-xs">{c.n}</div></div>))}</div></section>
  <section class="mb-8"><h2 class="text-lg font-bold mb-2">💣 Bombs ({bombs.length})</h2><div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">{bombs.map(b=>(<div class="p-2 rounded-lg border border-gray-200 dark:border-gray-700 flex justify-between text-xs"><span class="font-bold">{b.name}</span><span class={'px-1 py-0.5 rounded text-xs font-bold '+(RC[b.rarity]||'')}>{b.rarity}</span></div>))}</div><h2 class="text-lg font-bold mb-2">✨ Effects ({effects.length})</h2><div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4">{effects.map(e=>(<div class="p-2 rounded-lg border border-gray-200 dark:border-gray-700 flex justify-between text-xs"><span class="font-bold">{e.name}</span><span class={'px-1 py-0.5 rounded text-xs font-bold '+(RC[e.rarity]||'')}>{e.rarity}</span></div>))}</div><h2 class="text-lg font-bold mb-2">💃 Emotes ({emotes.length})</h2><div class="grid grid-cols-2 sm:grid-cols-5 gap-2">{emotes.map(e=>(<div class="p-2 rounded-lg border border-gray-200 dark:border-gray-700 flex justify-between text-xs"><span class="font-bold">{e.name}</span><span class={'px-1 py-0.5 rounded text-xs font-bold '+(RC[e.rarity]||'')}>{e.rarity}</span></div>))}</div></section>
  <div class="flex flex-wrap gap-2"><a href="/codes/" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">🎫 Codes</a><a href="/tier-list/" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🏆 Tier List</a></div>
</div>
</BaseLayout>
