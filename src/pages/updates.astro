---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
---
<BaseLayout title="Updates & Patch Notes" description="All Monkey Bomb Tag updates and patch notes in one place." path="/updates/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Updates',item:'https://monkey-bomb-tag.pages.dev/updates/'}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-6">🆕 Updates</h1>
  <div class="space-y-4">{[{v:'DUELS Update',d:'May 2026',t:'major',h:['Duels & Lava modes','Void Crate','New tails: Void Dominus, Nebula']},{v:'Ranked Update',d:'Apr 2026',t:'major',h:['Ranked with ELO','Weekly Quests','Factory map']},{v:'Cosmetics Update',d:'Mar 2026',t:'content',h:['15+ new cosmetics','Sky Islands map']},{v:'Launch',d:'Jan 2026',t:'launch',h:['Official launch','4 starting maps','10M visits first month']}].map((u,i)=>(<div class={'p-4 rounded-xl border '+(i===0?'border-green-300 bg-green-50 dark:bg-green-950/20':'border-gray-200 dark:border-gray-800')}><div class="flex items-center gap-2 mb-2"><span class={'px-2 py-0.5 rounded text-xs font-bold text-white '+(u.t==='major'?'bg-green-500':u.t==='launch'?'bg-amber-500':'bg-blue-500')}>{u.t}</span><h2 class="font-bold">{u.v}</h2><span class="text-xs text-gray-400 ml-auto">{u.d}</span></div><ul class="text-sm text-gray-600 space-y-0.5">{u.h.map(h=><li class="flex gap-1"><span class="text-green-500">•</span>{h}</li>)}</ul></div>))}</div>
  <div class="mt-6 flex flex-wrap gap-2"><a href="/codes" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">🎫 Codes</a><a href="/wiki" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold">📚 Wiki</a></div>
</div>
</BaseLayout>
