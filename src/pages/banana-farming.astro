---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getGameConfig } from '@/lib/data';
const config = getGameConfig();
---
<BaseLayout title="Monkey Bomb Tag Banana Farming — Fastest Earnings Guide" description="Fastest ways to farm Bananas in Monkey Bomb Tag. Compare Classic, Duels and Ranked modes with exact earnings per hour and optimal farming strategy." path="/banana-farming/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Banana Farming',item:'https://monkey-bomb-tag.pages.dev/banana-farming/'}]}]} />
<div class="max-w-4xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">Banana Farming Guide</h1>
  <p class="text-gray-500 text-sm mb-8">The fastest ways to earn Bananas in Monkey Bomb Tag — with exact numbers.</p>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">How Bananas Work</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">Bananas are the in-game currency in Monkey Bomb Tag. You earn them by playing rounds — winning gives more Bananas than losing. Bananas are used to buy Cases that contain cosmetics (Tails, Bomb Skins, Effects, Emotes).</p>
    <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-950/20 border border-amber-200 text-sm">
      <strong>Rates:</strong> Win = ~40 Bananas · Loss = ~15 Bananas · 2x Gamepass doubles all earnings.
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">Mode Comparison</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-gray-200 dark:border-gray-800"><th class="text-left py-2">Mode</th><th class="text-center py-2">Games/Hr</th><th class="text-center py-2">🍌/Hr (50% WR)</th><th class="text-center py-2">Best For</th></tr></thead>
        <tbody>
          <tr class="border-b border-gray-100 dark:border-gray-900 bg-green-50 dark:bg-green-950/20"><td class="py-2 font-bold">Duels</td><td class="py-2 text-center">~12</td><td class="py-2 text-center font-bold text-green-600">~330</td><td class="py-2 text-center">Fastest farming</td></tr>
          <tr class="border-b border-gray-100 dark:border-gray-900"><td class="py-2 font-bold">Classic</td><td class="py-2 text-center">~8</td><td class="py-2 text-center">~220</td><td class="py-2 text-center">Casual play</td></tr>
          <tr class="border-b border-gray-100 dark:border-gray-900"><td class="py-2 font-bold">Ranked</td><td class="py-2 text-center">~6</td><td class="py-2 text-center">~165</td><td class="py-2 text-center">Competitive</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">Best Farming Strategy</h2>
    <div class="space-y-3">
      <div class="p-4 rounded-xl border-2 border-green-300 dark:border-green-800 bg-green-50 dark:bg-green-950/20">
        <h3 class="font-bold mb-1">1. Play Duels Mode</h3>
        <p class="text-xs text-gray-600 dark:text-gray-400">Duels have the fastest game cycle (~5 min each). With a decent win rate, you earn the most Bananas per hour. Focus on 1v1 strategy — check our <a href="/best-strategy/" class="text-green-600 hover:underline">Best Strategy</a> guide.</p>
      </div>
      <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
        <h3 class="font-bold mb-1">2. Complete Weekly Quests</h3>
        <p class="text-xs text-gray-600 dark:text-gray-400">Weekly quests give bonus Bananas on top of normal earnings. Always check and complete them.</p>
      </div>
      <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
        <h3 class="font-bold mb-1">3. Use Free Codes</h3>
        <p class="text-xs text-gray-600 dark:text-gray-400">Redeem codes for free Bananas. Check our <a href="/codes/" class="text-green-600 hover:underline">Codes page</a> for all working codes — updated regularly.</p>
      </div>
      <div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
        <h3 class="font-bold mb-1">4. Consider the 2x Gamepass</h3>
        <p class="text-xs text-gray-600 dark:text-gray-400">If you play a lot, the 2x Bananas Gamepass doubles all earnings. It pays for itself quickly with consistent play.</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">How Many Bananas Do You Need?</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-gray-200 dark:border-gray-800"><th class="text-left py-2">Case</th><th class="text-right py-2">Cost</th><th class="text-right py-2">~Hours (Duels)</th></tr></thead>
        <tbody>{[{n:'Tails Case',p:250},{n:'Effects Case',p:300},{n:'Bomb Case',p:350},{n:'Emote Case',p:400},{n:'Void Crate',p:500}].map(c=>(
          <tr class="border-b border-gray-100 dark:border-gray-900"><td class="py-2">{c.n}</td><td class="py-2 text-right font-mono text-amber-500">🍌{c.p}</td><td class="py-2 text-right">~{Math.ceil(c.p/330*10)/10}hr</td></tr>
        ))}</tbody>
      </table>
    </div>
    <p class="mt-3"><a href="/banana-calculator/" class="text-green-600 hover:underline text-sm font-semibold">Calculate your exact earnings &rarr;</a></p>
  </section>

  <div class="mt-8 flex flex-wrap gap-2">
    <a href="/banana-calculator/" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">Banana Calculator</a>
    <a href="/best-cases/" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-semibold">Best Cases</a>
    <a href="/codes/" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">Free Codes</a>
  </div>
</div>
</BaseLayout>
