---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getActiveCodes, getExpiredCodes, getGameConfig } from '@/lib/data';
import CopyButton from '@/components/CopyButton';
const config = getGameConfig();
const active = getActiveCodes();
const expired = getExpiredCodes();
---
<BaseLayout title="Monkey Bomb Tag Codes (Working June 2026)" description="All working Monkey Bomb Tag codes for free Bananas and rewards. Updated daily with verified active and expired codes." path="/codes/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Codes',item:'https://monkey-bomb-tag.pages.dev/codes/'}]}, { '@context':'https://schema.org','@type':'FAQPage',mainEntity:[{'@type':'Question',name:'How do I redeem codes?',acceptedAnswer:{'@type':'Answer',text:'Find the codes chest in the lobby (left side). Enter code and confirm.'}},{'@type':'Question',name:'Why is my code not working?',acceptedAnswer:{'@type':'Answer',text:'Check spelling — M0NKE uses zero not O. May be expired.'}}]}]} />
<div class="max-w-5xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-1">🎫 Codes</h1>
  <p class="text-gray-500 text-xs mb-6">Verified working · Last checked: {config.stats.lastChecked}</p>
  <section class="mb-8">
    <h2 class="text-lg font-bold mb-3 flex items-center gap-2"><span class="w-3 h-3 bg-green-500 rounded-full"></span> Active ({active.length})</h2>
    <div class="space-y-3">{active.map(c=>(<div class="p-4 rounded-xl border border-gray-200 dark:border-gray-800">
      <div class="flex items-center justify-between mb-1"><div class="flex items-center gap-2"><code class="px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded font-mono font-bold text-sm">{c.code}</code>{c.isNew&&<span class="px-2 py-0.5 bg-green-500 text-white text-xs font-bold rounded">NEW</span>}</div><CopyButton client:load text={c.code} /></div>
      <p class="text-sm text-gray-600">🎁 {c.reward}</p>
      <p class="text-xs text-gray-400 mt-1">Source: {c.source}</p>
    </div>))}</div>
  </section>
  <section class="mb-8 p-4 rounded-xl bg-green-50 dark:bg-green-950/30 border border-green-200"><h2 class="font-bold mb-2 text-sm">📋 How to Redeem</h2><ol class="text-sm space-y-0.5"><li><strong>1.</strong> Open Monkey Bomb Tag</li><li><strong>2.</strong> Find Codes Chest in lobby (left side)</li><li><strong>3.</strong> Enter code → Confirm</li></ol><p class="text-xs text-gray-500 mt-1">💡 "M0NKE" uses zero (0), not letter O</p></section>
  {expired.length>0&&<section class="mb-8"><h2 class="text-lg font-bold mb-3 flex items-center gap-2"><span class="w-3 h-3 bg-gray-400 rounded-full"></span> Expired ({expired.length})</h2><div class="space-y-2">{expired.map(c=>(<div class="p-2 rounded-lg bg-gray-50 dark:bg-gray-900 opacity-60 flex items-center gap-2"><code class="px-3 py-1 bg-gray-200 dark:bg-gray-800 rounded font-mono text-sm line-through">{c.code}</code><span class="text-xs text-gray-400">— {c.reward}</span></div>))}</div></section>}
  <div class="flex flex-wrap gap-2"><a href="/best-cases/" class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-semibold">📦 Best Cases</a><a href="/banana-calculator/" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold">🍌 Banana Calc</a></div>
</div>
</BaseLayout>
