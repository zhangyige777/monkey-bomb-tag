---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
---
<BaseLayout title="Monkey Bomb Tag Code Location — How to Redeem Codes" description="Where to find and how to redeem codes in Monkey Bomb Tag. Step-by-step guide to the code redemption chest, troubleshooting expired codes, and getting new codes." path="/code-location/">
<JsonLd schema={[{ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://monkey-bomb-tag.pages.dev/'},{'@type':'ListItem',position:2,name:'Code Location',item:'https://monkey-bomb-tag.pages.dev/code-location/'}]},{'@context':'https://schema.org','@type':'HowTo','name':'How to Redeem Codes in Monkey Bomb Tag','step':[{'@type':'HowToStep','position':1,'name':'Open the game','text':'Launch Monkey Bomb Tag on Roblox and wait for the lobby to load.'},{'@type':'HowToStep','position':2,'name':'Find the code chest','text':'Look for the Codes Chest on the left side of the lobby area.'},{'@type':'HowToStep','position':3,'name':'Enter your code','text':'Click on the chest, type your code exactly as shown, and press Redeem.'},{'@type':'HowToStep','position':4,'name':'Claim rewards','text':'Your rewards (Bananas, items) will appear in your inventory.'}]}]} />
<div class="max-w-4xl mx-auto px-4 py-10">
  <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">Where to Redeem Codes in Monkey Bomb Tag</h1>
  <p class="text-gray-500 text-sm mb-8">Step-by-step guide to finding the code redemption location and claiming your free rewards.</p>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">Code Redemption Location</h2>
    <div class="p-4 rounded-xl bg-green-50 dark:bg-green-950/20 border border-green-200 mb-4">
      <p class="text-sm font-bold text-green-700 dark:text-green-400 mb-2">The Codes Chest is in the lobby, on the left side near the spawn area.</p>
      <p class="text-xs text-gray-600 dark:text-gray-400">Look for a treasure chest icon with "CODES" text above it. Walk up to it and click/tap to open the redemption dialog.</p>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">How to Redeem — Step by Step</h2>
    <div class="space-y-3">
      <div class="flex gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-800">
        <span class="flex-shrink-0 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm">1</span>
        <div><p class="font-bold text-sm">Open Monkey Bomb Tag on Roblox</p><p class="text-xs text-gray-600 dark:text-gray-400">Wait for the game to fully load into the lobby area.</p></div>
      </div>
      <div class="flex gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-800">
        <span class="flex-shrink-0 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm">2</span>
        <div><p class="font-bold text-sm">Find the Codes Chest</p><p class="text-xs text-gray-600 dark:text-gray-400">Walk to the left side of the lobby. The chest is near the spawn point — you can't miss it.</p></div>
      </div>
      <div class="flex gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-800">
        <span class="flex-shrink-0 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm">3</span>
        <div><p class="font-bold text-sm">Enter your code</p><p class="text-xs text-gray-600 dark:text-gray-400">Click/tap the chest. A text box appears. Type the code <strong>exactly as shown</strong> — codes are case-sensitive. Press Redeem.</p></div>
      </div>
      <div class="flex gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-800">
        <span class="flex-shrink-0 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold text-sm">4</span>
        <div><p class="font-bold text-sm">Claim your rewards</p><p class="text-xs text-gray-600 dark:text-gray-400">If the code works, you'll see a success message. Rewards (Bananas, cosmetics) go straight to your inventory.</p></div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">Why Is My Code Not Working?</h2>
    <ul class="text-sm text-gray-700 dark:text-gray-300 space-y-2 list-disc list-inside">
      <li><strong>Code expired.</strong> Codes have expiration dates. Check our <a href="/codes/" class="text-green-600 hover:underline font-semibold">active codes list</a> for currently working codes.</li>
      <li><strong>Typos.</strong> Codes are case-sensitive. Copy and paste directly from our codes page to avoid mistakes.</li>
      <li><strong>Already redeemed.</strong> Each code can only be used once per account.</li>
      <li><strong>Wrong game.</strong> Make sure you're in Monkey Bomb Tag, not a similar-named game.</li>
      <li><strong>Server lag.</strong> Try rejoining the game and redeeming again.</li>
    </ul>
  </section>

  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3">How to Get New Codes</h2>
    <ul class="text-sm text-gray-700 dark:text-gray-300 space-y-2 list-disc list-inside">
      <li><strong>Bookmark our <a href="/codes/" class="text-green-600 hover:underline font-semibold">Codes page</a></strong> — we update it when new codes are released.</li>
      <li><strong>Follow the developers</strong> on social media for code announcements.</li>
      <li><strong>Join the official Discord</strong> for the fastest code updates.</li>
      <li><strong>New codes usually drop</strong> with game updates, milestones (visits, likes), and special events.</li>
    </ul>
  </section>

  <div class="mt-8 flex flex-wrap gap-2">
    <a href="/codes/" class="px-4 py-2 bg-green-500 text-white rounded-lg text-sm font-semibold">All Active Codes</a>
    <a href="/beginner-guide/" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold">Beginner Guide</a>
  </div>
</div>
</BaseLayout>
